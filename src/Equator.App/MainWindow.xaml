<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Equator.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Equator.App.Localization"
    Title="EquatorSolver">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewAccelerator_Invoked" />
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OpenAccelerator_Invoked" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveAccelerator_Invoked" />
            <KeyboardAccelerator Key="F5" Invoked="EvaluateAllAccelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Modifiers="Control" Invoked="AbortAccelerator_Invoked" />
            <KeyboardAccelerator Key="Add" Modifiers="Control" Invoked="ZoomInAccelerator_Invoked" />
            <KeyboardAccelerator Key="Subtract" Modifiers="Control" Invoked="ZoomOutAccelerator_Invoked" />
            <KeyboardAccelerator Key="F1" Invoked="HelpAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="14,0,0,0" FlowDirection="LeftToRight">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="5" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock Text="∫" FontFamily="Cambria Math" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,-2,0,0" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <TextBlock Text="Equator" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock x:Name="DocumentTitle" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Commands -->
        <CommandBar Grid.Row="1" HorizontalAlignment="Left" DefaultLabelPosition="Right" Margin="4,0,0,2" Background="Transparent">
            <AppBarButton l:Tr.Text="tb.new" l:Tr.ToolTip="tb.new.tip" Click="New_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8A5;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton l:Tr.Text="tb.open" l:Tr.ToolTip="tb.open.tip" Click="Open_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8E5;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton l:Tr.Text="tb.save" l:Tr.ToolTip="tb.save.tip" Click="Save_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton l:Tr.Text="tb.runAll" l:Tr.ToolTip="tb.runAll.tip" Click="EvaluateAll_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE768;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="AbortButton" l:Tr.Text="tb.stop" l:Tr.ToolTip="tb.stop.tip" Click="Abort_Click" IsEnabled="False">
                <AppBarButton.Icon><FontIcon Glyph="&#xE71A;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton l:Tr.Text="tb.clear" Click="ClearOutputs_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE894;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton l:Tr.Text="tb.reset" l:Tr.ToolTip="tb.reset.tip" Click="Restart_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton l:Tr.Text="tb.addCell" Click="AddCell_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton l:Tr.Text="tb.zoomIn" Click="ZoomIn_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8A3;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton l:Tr.Text="tb.zoomOut" Click="ZoomOut_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE71F;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton l:Tr.Text="tb.theme" Click="Theme_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE793;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton l:Tr.Text="tb.language">
                    <AppBarButton.Icon><FontIcon Glyph="&#xF2B7;" /></AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="LanguageMenu" Placement="LeftEdgeAlignedTop" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton l:Tr.Text="tb.examples" Click="Examples_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE734;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton l:Tr.Text="tb.shortcuts" Click="Help_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE765;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <!-- Store trial: days left, or trial ended (see Services/Licensing.cs) -->
        <InfoBar x:Name="LicenseBar" Grid.Row="2" Margin="8,0,8,6" IsOpen="False">
            <InfoBar.ActionButton>
                <Button x:Name="BuyButton" l:Tr.Text="license.buy" Click="Buy_Click" Style="{StaticResource AccentButtonStyle}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Notebook -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,1,0" CornerRadius="0,8,0,0">
                <ScrollViewer x:Name="NotebookScroller" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CellsPanel" MaxWidth="1180" Spacing="4" Padding="6,14,20,200" />
                </ScrollViewer>
            </Border>

            <!-- Side panel -->
            <Grid Grid.Column="1" Padding="14,4,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <SelectorBar x:Name="SidePanelSelector" SelectionChanged="SidePanelSelector_SelectionChanged">
                    <SelectorBarItem x:Name="FunctionsTab" l:Tr.Text="side.functions" IsSelected="True" />
                    <SelectorBarItem x:Name="VariablesTab" l:Tr.Text="side.variables" />
                    <SelectorBarItem x:Name="GuideTab" l:Tr.Text="side.guide" />
                </SelectorBar>

                <Grid x:Name="FunctionsPanel" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock l:Tr.Text="side.symbols" Style="{StaticResource PanelHeader}" />
                    <StackPanel x:Name="SymbolsPanel" Grid.Row="1" Spacing="4" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                    <AutoSuggestBox x:Name="FunctionSearch" Grid.Row="2" Margin="0,14,0,8" l:Tr.Text="side.search"
                                    QueryIcon="Find" TextChanged="FunctionSearch_TextChanged" />
                    <ListView x:Name="FunctionList" Grid.Row="3" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="FunctionList_ItemClick" Padding="0,0,0,12" />
                </Grid>

                <Grid x:Name="VariablesPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock l:Tr.Text="side.defined" Style="{StaticResource PanelHeader}" />
                    <ListView x:Name="VariableList" Grid.Row="1" SelectionMode="None" />
                </Grid>

                <ScrollViewer x:Name="GuidePanel" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel x:Name="GuideContent" Spacing="6" Padding="0,8,8,24" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="4" Padding="14,5" Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                <TextBlock x:Name="StatusText" l:Tr.Text="status.ready" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <TextBlock x:Name="StatusRight" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       l:Tr.Text="status.hints" />
        </Grid>
    </Grid>
</Window>
