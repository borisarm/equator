<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Equator.App.Controls.CellControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Equator.App.Localization">

    <Grid x:Name="Root" Padding="0,6,8,8" Background="Transparent"
          PointerEntered="Root_PointerEntered" PointerExited="Root_PointerExited">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Step badge: a ring before the step runs, the step number once it has a result. -->
        <Grid x:Name="Badge" Grid.Column="0" Width="28" Height="28" Margin="0,4,14,0" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Ellipse x:Name="BadgeRing" Style="{StaticResource BadgeRingPending}" />
            <TextBlock x:Name="BadgeText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="12" FontWeight="SemiBold" Margin="0,-1,0,0" />
            <ProgressRing x:Name="Busy" Width="28" Height="28" IsActive="False" Visibility="Collapsed" />
        </Grid>

        <TextBox x:Name="Input" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap"
                 IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                 FontFamily="Cascadia Mono, Consolas" FontSize="15" MinHeight="36" FlowDirection="LeftToRight"
                 l:Tr.Name="cell.input" l:Tr.Text="cell.placeholder"
                 PreviewKeyDown="Input_PreviewKeyDown" GotFocus="Input_GotFocus" LostFocus="Input_LostFocus" />

        <StackPanel x:Name="Tools" Grid.Column="2" Orientation="Horizontal" Margin="4,2,0,0"
                    VerticalAlignment="Top" Spacing="2" Opacity="0">
            <Button x:Name="RunButton" Style="{StaticResource CellToolButton}" Click="Run_Click"
                    l:Tr.Name="cell.run" l:Tr.ToolTip="cell.run.tip">
                <FontIcon Glyph="&#xE768;" FontSize="13" />
            </Button>
            <Button Style="{StaticResource CellToolButton}" l:Tr.Name="cell.options" l:Tr.ToolTip="cell.more">
                <FontIcon Glyph="&#xE712;" FontSize="13" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem l:Tr.Text="cell.insertAbove" Click="InsertAbove_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70E;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem l:Tr.Text="cell.insertBelow" Click="InsertBelow_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70D;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem l:Tr.Text="cell.moveUp" Click="MoveUp_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74A;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem l:Tr.Text="cell.moveDown" Click="MoveDown_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74B;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem l:Tr.Text="cell.clear" Click="ClearOutput_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE894;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem l:Tr.Text="cell.delete" Click="Delete_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <!-- Results, in an answer panel under the input. -->
        <StackPanel x:Name="Outputs" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Spacing="8" FlowDirection="LeftToRight" />
    </Grid>
</UserControl>
