<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Equator.App.Controls.CellControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Padding="0,4,8,6" Background="Transparent"
          PointerEntered="Root_PointerEntered" PointerExited="Root_PointerExited">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="84" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Accent bar marking the active cell -->
        <Rectangle x:Name="FocusBar" Grid.RowSpan="2" Width="3" Margin="4,2,0,2" HorizontalAlignment="Left"
                   RadiusX="1.5" RadiusY="1.5" Opacity="0"
                   Fill="{ThemeResource AccentFillColorDefaultBrush}" />

        <TextBlock x:Name="InLabel" Grid.Column="0" Margin="0,9,10,0" HorizontalAlignment="Right"
                   FontFamily="Cascadia Mono, Consolas" FontSize="12" Text="In[ ]:="
                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

        <TextBox x:Name="Input" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap"
                 IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                 FontFamily="Cascadia Mono, Consolas" FontSize="15" MinHeight="36" AutomationProperties.Name="Cell input"
                 PlaceholderText="Enter an expression — Shift+Enter to evaluate"
                 PreviewKeyDown="Input_PreviewKeyDown" GotFocus="Input_GotFocus" LostFocus="Input_LostFocus" />

        <StackPanel x:Name="Tools" Grid.Column="2" Orientation="Horizontal" Margin="4,2,0,0"
                    VerticalAlignment="Top" Spacing="2" Opacity="0">
            <Button x:Name="RunButton" Style="{StaticResource CellToolButton}" Click="Run_Click"
                    AutomationProperties.Name="Evaluate cell" ToolTipService.ToolTip="Evaluate (Shift+Enter)">
                <FontIcon Glyph="&#xE768;" FontSize="13" />
            </Button>
            <Button Style="{StaticResource CellToolButton}" AutomationProperties.Name="Cell options" ToolTipService.ToolTip="More">
                <FontIcon Glyph="&#xE712;" FontSize="13" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="Insert cell above" Click="InsertAbove_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70E;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Insert cell below" Click="InsertBelow_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70D;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Move up" Click="MoveUp_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74A;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Move down" Click="MoveDown_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74B;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Clear output" Click="ClearOutput_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE894;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Delete cell" Click="Delete_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <ProgressRing x:Name="Busy" Grid.Column="2" Width="18" Height="18" Margin="8,9,4,0"
                      VerticalAlignment="Top" IsActive="False" Visibility="Collapsed" />

        <StackPanel x:Name="Outputs" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0" Spacing="8" />
    </Grid>
</UserControl>
