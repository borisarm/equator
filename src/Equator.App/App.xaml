<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Equator.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CellToolButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="6,5" />
                <Setter Property="MinWidth" Value="30" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="SymbolButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontFamily" Value="Cambria Math" />
                <Setter Property="FontSize" Value="16" />
            </Style>

            <Style x:Key="PanelHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,12,0,6" />
            </Style>

            <!-- Styles for elements created in code: ThemeResource in a style follows the element's own theme. -->
            <Style x:Key="SecondaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="TertiaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <Style x:Key="AccentText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="ErrorText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="ErrorIcon" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>

            <!-- Cell result panel and its arrow. -->
            <Style x:Key="AnswerPanel" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,8,10,8" />
            </Style>
            <Style x:Key="AnswerArrow" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,-2,0,0" />
            </Style>
            <!-- Step badge ring before a cell has run. -->
            <Style x:Key="BadgeRingPending" TargetType="Ellipse">
                <Setter Property="Stroke" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="Fill" Value="Transparent" />
            </Style>
            <Style x:Key="BadgeRingFocused" TargetType="Ellipse">
                <Setter Property="Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="Fill" Value="Transparent" />
            </Style>
            <Style x:Key="BadgeRingDone" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="StrokeThickness" Value="0" />
            </Style>
            <Style x:Key="BadgeRingError" TargetType="Ellipse">
                <Setter Property="Stroke" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="Fill" Value="Transparent" />
            </Style>
            <Style x:Key="BadgeTextDone" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
